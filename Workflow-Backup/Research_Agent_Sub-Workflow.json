      {
        "parameters": {
          "jsCode": "const results = $input.first().json.organic_results || [];\n\nreturn results.map(result => ({\n  json: {\n    link: result.link,\n    title: result.title\n  }\n}));"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          656,
          192
        ],
        "id": "cccccccc-cccc-cccc-cccc-cccccccccccc",
        "name": "URL Extractor "
      },
      {
        "parameters": {
          "jsCode": "const results = $input.all();\nconst blockedDomains = ['medium.com', 'reddit.com', 'quora.com', 'wsj.com', 'cnn.com'];\n\nconst filtered = results.filter(item => {\n  const url = item.json.link || '';\n  const isBlocked = blockedDomains.some(domain => url.includes(domain));\n  return !isBlocked;\n});\n\nreturn filtered;"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          864,
          192
        ],
        "id": "cccccccc-cccc-cccc-cccc-cccccccccccc",
        "name": "Domain filter"
      },
      {
        "parameters": {
          "jsCode": "const input = $input.all();\n\nreturn input.map(item => {\n  let text = item.json.text || '';\n  \n  // Remove common noise patterns\n  text = text\n    .replace(/\\[https?:\\/\\/[^\\]]+\\]/g, '') // Remove markdown links\n    .replace(/Image Source:.*/g, '') // Remove image credits\n    .replace(/SHARE TO.*/g, '') // Remove social buttons\n    .replace(/\\n{3,}/g, '\\n\\n') // Collapse multiple newlines\n    .replace(/^\\s*[\\*\\-]\\s+/gm, '') // Remove bullet points\n    .trim();\n  \n  return {\n    json: {\n      text: text,\n      source: item.json.source || 'unknown'\n    }\n  };\n});"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1744,
          96
        ],
        "id": "cccccccc-cccc-cccc-cccc-cccccccccccc",
        "name": "Noise Remover"
      },
      {
        "parameters": {
          "jsCode": "const items = $input.all();\n\nconst allText = items\n  .flatMap(item => {\n    if (Array.isArray(item.json.data)) {\n      return item.json.data.map(d => d.text || '');\n    }\n    return item.json.text || '';\n  })\n  .filter(Boolean)\n  .join('\\n\\n')\n  .slice(0, 2000); // VERY aggressive - ~500 tokens\n\nreturn [{\n  json: {\n    chatInput: allText\n  }\n}];"
        },
