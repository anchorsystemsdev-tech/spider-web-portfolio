        ],
        "typeVersion": 4.2,
        "onError": "continueRegularOutput"
      },
      {
        "parameters": {
          "jsCode": "const html = $input.first().json.data || '';\nconst emailRegex = /[a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+\\.(?!jpeg|jpg|png|gif|webp|svg)[a-zA-Z]{2,}/g;\nconst emails = html.match(emailRegex) || [];\nconst filtered = emails.filter(e => {\n  const [local, domain] = e.split('@');\n  // blocks known spam/system prefixes\n  const badPrefix = /noreply|no-reply|donotreply|admin@|contact@|support@|hello@|mail@/i.test(e);\n  // blocks error tracking and bot-generated domains — sentry embeds these in every Wix site\n  // using regex over an array of .includes() checks because one line covers all subdomains (sentry-next.wixpress, sentry.wixpress, etc.)\n  const badDomain = /sentry|wixpress|wix\\.com|bugsnag|rollbar|datadog|newrelic|loggly|raygun/i.test(domain);\n  // blocks local parts that are hex hashes — real emails don't look like 605a7baede844d278b89dc95ae0a9123\n  // regex checks: 20+ chars using only hex characters [a-f0-9]\n  // threshold is 20 not 32 to catch shorter hashes too, without hitting real short emails\n  const looksLikeHash = /^[a-f0-9]{20,}$/.test(local);\n  return !badPrefix && !badDomain && !looksLikeHash;\n});\nif (filtered.length === 0) return [];\nreturn { \n  json: { \n    emails: filtered, \n    phone: $('Extract & Clean URLs').item.json.phone || null,\n    website: $('Extract & Clean URLs').item.json.website || null\n  } \n};"
        },
        "id": "cccccccc-cccc-cccc-cccc-cccccccccccc",
        "name": "Extract Emails & Filter",
        "type": "n8n-nodes-base.code",
        "position": [
          1696,
          176
        ],
        "typeVersion": 2,
        "alwaysOutputData": true,
        "onError": "continueRegularOutput"
      },
      {
        "parameters": {
          "jsCode": "const items = $input.all();\nconst allEmails = new Set();\n\nconst dataItem = items.find(item => item.json.phone || item.json.website) || items[0];\n\nitems.forEach(item => {\n  const emails = item.json.emails;\n  if (Array.isArray(emails)) {\n    emails.forEach(email => allEmails.add(email.toLowerCase().trim()));\n  }\n});\n\nconst existingEmails = new Set(\n  $('Read Existing Leads').all().map(item => item.json.email?.toLowerCase().trim()).filter(Boolean)\n);\n\nreturn Array.from(allEmails)\n  .filter(email => !existingEmails.has(email))\n  .map(email => ({\n    json: {\n      email,\n      phone: dataItem.json.phone || null,\n      website: dataItem.json.website || null,\n      search_query: $('Chat Trigger').first().json.chatInput,\n      scraped_at: new Date().toISOString()\n    }\n  }));"
        },
