      {
        "parameters": {
          "jsCode": "const results = $input.first().json.local_results || [];\nconst placeResult = $input.first().json.place_results;\nconst toProcess = results.length > 0 ? results : (placeResult ? [placeResult] : []);\n\nconst urls = [...new Set(\n  toProcess\n    .map(r => r.website || r.links?.website)\n    .filter(url => !!url)\n    .filter(url => !url.match(/facebook|instagram|youtube|twitter|yelp|tripadvisor|google/i))\n)].map(website => {\n  // find the matching result to grab its phone\n  // .find() instead of assuming index match because deduplication above can shift positions\n  const match = toProcess.find(r => (r.website || r.links?.website) === website);\n  return { json: { website, phone: match?.phone || null } };\n});\n\nreturn urls;"
        },
        "id": "cccccccc-cccc-cccc-cccc-cccccccccccc",
